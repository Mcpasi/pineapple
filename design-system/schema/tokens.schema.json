{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode.design/schema/tokens-1.0.json",
  "title": "Framework-neutral semantic design tokens",
  "type": "object",
  "required": [
    "schemaVersion",
    "themes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "themes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
