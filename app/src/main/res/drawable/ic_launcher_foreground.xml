<?xml version="1.0" encoding="utf-8"?>
<!--
  Material Symbols Rounded, converted from the upstream SVG.

  Licensed under the Apache License 2.0, which is compatible with this
  project's MIT licence. https://fonts.google.com/icons

  Material Symbols draws in a y-up-offset space: the viewBox is
  "0 -960 960 960", so y runs from -960 to 0. Android's viewport runs 0 to 960
  with y increasing downward. The two differ by a pure translation of +960 in
  y, not a flip, so the path data below is byte-for-byte the upstream data and
  the shift is applied once, by a group transform. Doing it that way means no
  coordinate had to be recomputed by hand, which is where transcription bugs
  would otherwise live.

  Colours are deliberately omitted: these are tinted at the call site, so a
  single asset serves both the active and inactive state of a control.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Body: an ellipse, centred low enough to leave room for the crown. -->
    <path
        android:fillColor="#FFFF5500"
        android:pathData="M54,45
            C62.8,45 70,52.6 70,62
            C70,71.4 62.8,79 54,79
            C45.2,79 38,71.4 38,62
            C38,52.6 45.2,45 54,45 Z" />

    <!-- Crown: three leaves fanning up from the top of the body. -->
    <path
        android:fillColor="#FFFF5500"
        android:pathData="M54,26 L60,48 L48,48 Z" />
    <path
        android:fillColor="#FFFF5500"
        android:pathData="M39,32 L51,50 L42,50 Z" />
    <path
        android:fillColor="#FFFF5500"
        android:pathData="M69,32 L66,50 L57,50 Z" />
</vector>
